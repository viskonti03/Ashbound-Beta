# Locally, leave VITE_SERVER_URL unset to use the Vite /socket.io proxy.
# Set this value in Vercel, not in a committed .env file. Redeploy after changes.
# VITE_SERVER_URL=https://YOUR-RENDER-SERVICE.onrender.com

# Set this separately in Render: exact frontend origins, separated by commas.
# CLIENT_ORIGINS=https://YOUR-APP.vercel.app

# Render normally sets PORT automatically. For local development it defaults to 3001.
# PORT=3001
